[Unit]
Description=BuilderXAI public bot %i (Hermes in rootless container, user bx)
After=bx-egress.service bx-llm-gw.service network-online.target user@1002.service
Requires=bx-egress.service user@1002.service
Wants=bx-llm-gw.service

[Service]
User=bx
Group=bx
# systemd reads these as root; values reach the container by name only (never in argv)
EnvironmentFile=/etc/builderxai/secrets/llm-builderxai.env
EnvironmentFile=/etc/builderxai/secrets/%i.env
Environment=XDG_RUNTIME_DIR=/run/user/1002
Environment=DOCKER_HOST=unix:///run/user/1002/docker.sock
ExecStartPre=-/usr/bin/docker rm -f bot-%i
ExecStart=/usr/bin/docker run --rm --name bot-%i \
  --memory 2g --pids-limit 512 --cpus 1 \
  --security-opt no-new-privileges \
  --dns 1.1.1.1 --dns 8.8.8.8 \
  -e DISCORD_BOT_TOKEN -e CLIAPI_API_KEY \
  -e DISCORD_ALLOW_ALL_USERS=true \
  -e HERMES_GATEWAY_NO_SUPERVISE=1 \
  -v /home/bx/bots/%i:/opt/data \
  nousresearch/hermes-agent:v0.22.5 gateway run
ExecStop=/usr/bin/docker stop -t 20 bot-%i
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
